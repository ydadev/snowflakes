{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snowflakes:configuration:1",
  "title": "Snowflakes assigned configuration v1",
  "description": "A complete, atomic weather profile. Transport limit: 65536 UTF-8 bytes; integer fields use integer JSON tokens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "revision",
    "profile_id",
    "global_enabled",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
    },
    "global_enabled": {
      "type": "boolean"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effects_enabled",
        "weather",
        "snow",
        "rain",
        "interaction",
        "performance",
        "display"
      ],
      "properties": {
        "effects_enabled": {
          "type": "boolean"
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "opacity_percent"
          ],
          "properties": {
            "mode": {
              "enum": [
                "snow",
                "rain"
              ]
            },
            "opacity_percent": {
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            }
          }
        },
        "snow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intensity_percent",
            "drift_size_percent",
            "wind_percent",
            "on_windows",
            "on_ground",
            "melting"
          ],
          "properties": {
            "intensity_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "drift_size_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "wind_percent": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "on_windows": {
              "type": "boolean"
            },
            "on_ground": {
              "type": "boolean"
            },
            "melting": {
              "type": "boolean"
            }
          }
        },
        "rain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intensity_percent",
            "puddle_size_percent",
            "wind_percent",
            "on_windows",
            "on_ground",
            "evaporation"
          ],
          "properties": {
            "intensity_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "puddle_size_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "wind_percent": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "on_windows": {
              "type": "boolean"
            },
            "on_ground": {
              "type": "boolean"
            },
            "evaporation": {
              "type": "boolean"
            }
          }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cursor_enabled"
          ],
          "properties": {
            "cursor_enabled": {
              "type": "boolean"
            }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_fps",
            "battery_saver",
            "pause_fullscreen",
            "pause_remote_session"
          ],
          "properties": {
            "target_fps": {
              "type": "integer",
              "enum": [
                30,
                60
              ]
            },
            "battery_saver": {
              "type": "boolean"
            },
            "pause_fullscreen": {
              "type": "boolean"
            },
            "pause_remote_session": {
              "type": "boolean"
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection",
            "monitor_ids"
          ],
          "properties": {
            "selection": {
              "enum": [
                "all",
                "primary",
                "selected"
              ]
            },
            "monitor_ids": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f]+(?![\\s\\S])"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "selection": {
                    "const": "selected"
                  }
                }
              },
              "then": {
                "properties": {
                  "monitor_ids": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "monitor_ids": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
